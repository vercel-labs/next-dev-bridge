{
  "name": "next-dev-bridge",
  "version": "0.3.0",
  "description": "Bridge a running Next.js dev server to normalized build and runtime state events.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/next-dev-bridge.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "next-dev-bridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "packageManager": "bun@1.1.30",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "observe": "node dist/cli.js observe http://localhost:3000 --verbose",
    "example:web": "bun run build && bun examples/next-dev-bridge-web/run.cjs",
    "scenario": "bun test/next-app-scenarios.mjs",
    "test:app": "bun run build && bun --cwd test/next-app ../../node_modules/.bin/next dev -p 3000",
    "prepack": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "test:unit": "vitest run test",
    "test": "bun test/run-tests.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vercel/sandbox": "^1.10.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "respinner": "^4.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT"
}
